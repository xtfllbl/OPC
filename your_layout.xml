<FrameLayout
    android:id="@+id/doorVisual"
    android:layout_width="240dp"
    android:layout_height="320dp">

    <View
        android:id="@+id/ringView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/cabinetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/interiorGlowView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/doorShadowView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/doorPanelView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <View
        android:id="@+id/lockGlowView"
        android:layout_width="92dp"
        android:layout_height="92dp" />

    <View
        android:id="@+id/shackleView"
        android:layout_width="50dp"
        android:layout_height="40dp" />
</FrameLayout>
